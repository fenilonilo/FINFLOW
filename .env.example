DATABASE_URL=postgresql://finflow:finflow@db:5432/finflow
SECRET_KEY=change-me-in-production
POSTGRES_DB=finflow
POSTGRES_USER=finflow
POSTGRES_PASSWORD=finflow
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=30

# Servidor MCP (docs/MCP.md). Token >= 32 chars: python -c "import secrets; print(secrets.token_urlsafe(36))"
FINFLOW_MCP_TOKEN=troque-por-um-token-aleatorio-com-pelo-menos-32-caracteres
FINFLOW_MCP_USER_EMAIL=voce@exemplo.com

# LLM local (llama-server, API OpenAI) para categorizar compras na importação de fatura.
# Vazio = desligado (usa palavra-chave/categoria do banco). Ex.: http://host.docker.internal:8099
LLM_URL=
LLM_TIMEOUT=20
